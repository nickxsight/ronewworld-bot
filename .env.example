# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
DISCORD_TOKEN=ใส่โทเคนบอทที่นี่
# (ไม่บังคับ) ใส่ Guild ID เพื่อให้ slash command ขึ้นทันทีในเซิร์ฟเวอร์ทดสอบ
DEV_GUILD_ID=
# (Railway) ที่เก็บไฟล์ตั้งค่า ชี้ไปที่ Volume เพื่อไม่ให้หายตอน redeploy
SETTINGS_PATH=/data/settings.json
# (โฮสต์ฟรีดิสก์ไม่ถาวร) ห้องและยศเริ่มต้น จะได้ไม่ต้อง /ro setchannel ใหม่ทุกครั้งที่ deploy
DEFAULT_CHANNEL_ID=
DEFAULT_ROLE_ID=
# เสียงบนคอมที่รันบอท (1 = เปิด, 0 = ปิด)
LOCAL_SOUND=1
# (ไม่บังคับ) ห้องเสียงเริ่มต้นสำหรับเล่นเสียงเตือน
DEFAULT_VOICE_CHANNEL_ID=
